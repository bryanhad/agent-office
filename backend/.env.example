# Copy this file to .env and fill it in. Variables set in your shell override this file.

# Required. Generate with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional config (not secrets). Uncomment to change the defaults.
# Backend port.
# PORT=3001
# Frontend (Vite) port; the backend only accepts requests from this origin.
# WEB_PORT=5173
# Open this project on startup and skip the start screen. The instance is then pinned to it.
# PROJECT_DIR=~/projects/my-app
# Main model (alias or full ID). Unset uses your account's default.
# MODEL=sonnet
